
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=content_copilot
GEMINI_API_KEY=

# PostgreSQL administrator password
POSTGRES_ADMIN_PASSWORD=

# Application database account
POSTGRES_APP_USER=ai_content_app
POSTGRES_APP_PASSWORD=

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=ai_content_copilot

# SHA-256 API-key digest to server-side user ID mapping.
# Generate a real value for .env; never put a live key in this file.
API_KEY_HASHES={}