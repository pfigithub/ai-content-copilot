OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=content_copilot
GEMINI_API_KEY=

# PostgreSQL administrator password
POSTGRES_ADMIN_PASSWORD=

# Application database account
POSTGRES_APP_USER=ai_content_app
POSTGRES_APP_PASSWORD=

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=ai_content_copilot

# SHA-256 API-key digest to server-side user ID mapping.
# Generate a real value for .env; never put a live key in this file.
API_KEY_HASHES={}

# JWT signing secret. Generate a fresh value with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Never commit the real value to version control.
JWT_SECRET=

# JWT iss/aud claims (safe to leave as defaults unless you deploy
# multiple independent services under the same signing key).
JWT_ISSUER=ai-content-copilot
JWT_AUDIENCE=api

# Root Admin Credentials (Change in production!)
FIRST_SUPERUSER_USERNAME=
FIRST_SUPERUSER_PASSWORD=